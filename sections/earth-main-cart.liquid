<section class="page-shell earth-page-tight">
  <div class="earth-wrap">
    <div class="earth-cart-head earth-shadow-lg">
      <div>
        <p class="earth-mono earth-k-label">{{ section.settings.eyebrow_label }}</p>
        <h1 class="earth-title earth-page-title">{{ section.settings.heading }}</h1>
      </div>
      <a href="{{ routes.all_products_collection_url }}" class="earth-btn earth-btn--light earth-shadow-sm">{{ section.settings.continue_shopping_label }}</a>
    </div>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <div class="earth-cart-grid">
          <div class="earth-cart-lines earth-shadow-lg">
            {%- for item in cart.items -%}
              <article class="earth-cart-line">
                <a href="{{ item.url }}" class="earth-cart-media" style="background: {% cycle '#c9a87c', '#7a8b5c', '#c67a4a', '#8b7355' %};">
                  {%- if item.image -%}
                    {{ item.image | image_url: width: 360 | image_tag: loading: 'lazy', alt: item.image.alt }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </a>

                <div class="earth-cart-meta">
                  <h2 class="earth-title earth-cart-item-title">
                    <a href="{{ item.url }}">{{ item.product.title }}</a>
                  </h2>

                  {%- unless item.product.has_only_default_variant -%}
                    <p class="earth-mono earth-variant-copy">{{ item.variant.title }}</p>
                  {%- endunless -%}

                  <p class="earth-mono earth-price-chip">{{ item.final_price | money }}</p>
                </div>

                <div class="earth-cart-actions">
                  <label class="earth-mono" for="Updates_{{ item.key }}">{{ section.settings.quantity_label }}</label>
                  <input
                    class="earth-qty"
                    id="Updates_{{ item.key }}"
                    type="number"
                    name="updates[]"
                    value="{{ item.quantity }}"
                    min="0"
                  >

                  <a class="earth-btn earth-btn--light earth-shadow-sm" href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0">{{ section.settings.remove_label }}</a>
                </div>
              </article>
            {%- endfor -%}
          </div>

          <aside class="earth-cart-summary earth-shadow-lg">
            <h2 class="earth-title earth-cart-title">{{ section.settings.summary_heading }}</h2>

            <div class="earth-summary-row earth-mono">
              <span>{{ section.settings.items_label }}</span>
              <span>{{ cart.item_count }}</span>
            </div>

            <div class="earth-summary-row earth-mono earth-summary-total">
              <span>{{ section.settings.total_label }}</span>
              <strong>{{ cart.total_price | money }}</strong>
            </div>

            <button class="earth-btn earth-btn--light earth-shadow-sm earth-w-full earth-stack-gap-bottom" type="submit" name="update">
              {{ section.settings.update_button_label }}
            </button>
            <button class="earth-btn earth-btn--dark earth-shadow-sm earth-w-full" type="submit" name="checkout">
              {{ section.settings.checkout_button_label }}
            </button>

            <p class="earth-mono earth-checkout-note">
              {{ section.settings.checkout_note }}
            </p>
          </aside>
        </div>
      </form>
    {%- else -%}
      <div class="earth-cart-empty earth-shadow-lg">
        <h2 class="earth-title earth-empty-title">{{ section.settings.empty_heading }}</h2>
        <p class="earth-mono earth-empty-copy">{{ section.settings.empty_copy }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="earth-btn earth-btn--dark earth-shadow-sm">{{ section.settings.empty_button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Earth Main Cart",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_label",
      "label": "Eyebrow label",
      "default": "Cart"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "ROOTED BAG"
    },
    {
      "type": "text",
      "id": "continue_shopping_label",
      "label": "Continue shopping label",
      "default": "Continue Shopping"
    },
    {
      "type": "text",
      "id": "quantity_label",
      "label": "Quantity label",
      "default": "Qty"
    },
    {
      "type": "text",
      "id": "remove_label",
      "label": "Remove label",
      "default": "Remove"
    },
    {
      "type": "text",
      "id": "summary_heading",
      "label": "Summary heading",
      "default": "Summary"
    },
    {
      "type": "text",
      "id": "items_label",
      "label": "Items label",
      "default": "Items"
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "Total label",
      "default": "Total"
    },
    {
      "type": "text",
      "id": "update_button_label",
      "label": "Update button label",
      "default": "Update Cart"
    },
    {
      "type": "text",
      "id": "checkout_button_label",
      "label": "Checkout button label",
      "default": "Checkout"
    },
    {
      "type": "textarea",
      "id": "checkout_note",
      "label": "Checkout note",
      "default": "Shipping and taxes calculated at checkout."
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "Empty cart heading",
      "default": "Your Cart Is Empty"
    },
    {
      "type": "textarea",
      "id": "empty_copy",
      "label": "Empty cart copy",
      "default": "No products in your rooted bag yet."
    },
    {
      "type": "text",
      "id": "empty_button_label",
      "label": "Empty cart button label",
      "default": "Browse Products"
    }
  ]
}
{% endschema %}
